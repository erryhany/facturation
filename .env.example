# Copier ce fichier en .env puis choisir les mots de passe (le fichier .env n'est jamais commité).
# Spring Boot lit ce fichier automatiquement au démarrage (spring.config.import dans application.properties).

# Mot de passe du compte "admin" (rôle ADMIN)
ADMIN_PASSWORD=

# Mot de passe du compte "user" (rôle USER)
USER_PASSWORD=
